# ══════════════════════════════════════════════════════════════
#  EMA8 Scalper Bot — Variables de Entorno
#  Copia este archivo a .env para desarrollo local
#  En Railway: configura estas variables en el panel de Railway
# ══════════════════════════════════════════════════════════════

# ── BingX API (obtener en: https://bingx.com/en/account/api/) ──
BINGX_API_KEY=tu_api_key_aqui
BINGX_API_SECRET=tu_api_secret_aqui

# ── Telegram (crear bot con @BotFather) ───────────────────────
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-100123456789

# ── Modo de operación ─────────────────────────────────────────
# true = simulación (recomendado para empezar)
# false = trading real con dinero real ⚠️
DRY_RUN=true

# ── Símbolos ──────────────────────────────────────────────────
# Vacío = escanea todos los pares de alta liquidez
# Para específicos: BTC-USDT,ETH-USDT,SOL-USDT
SYMBOLS=

# ── Liquidez ─────────────────────────────────────────────────
# high_only = solo top 20 pares (recomendado)
# all = todo el mercado
LIQUIDITY_MODE=high_only

# ── Riesgo (ajusta según tu capital) ─────────────────────────
RISK_PER_TRADE=1.0       # % del balance por trade (1% = conservador)
MAX_OPEN_TRADES=4        # máximo trades simultáneos
LEVERAGE=5               # apalancamiento (5x = seguro para empezar)
MAX_SIGNALS_DAY=12       # máximo señales por día

# ── Stop Loss / Take Profit (fallback si ATR falla) ──────────
SL_PCT=0.8               # % stop loss
TP1_PCT=1.6              # % take profit 1
TP2_PCT=3.2              # % take profit 2

# ── Funciones avanzadas ───────────────────────────────────────
USE_TRAILING_STOP=true   # trailing stop automático
USE_SESSION_FILTER=true  # solo operar en sesiones activas

# ── Scanner ───────────────────────────────────────────────────
SCAN_INTERVAL_SECONDS=180  # cada 3 minutos
MIN_BAR_VOL_USDT=500000    # volumen mínimo por vela en USDT
COOLDOWN_BARS=5            # velas de espera entre señales del mismo par
